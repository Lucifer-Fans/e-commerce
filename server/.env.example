# Copy to .env and fill in the blanks. Never commit the real .env.

# ---------- Core ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/premium-ecommerce
# Connection pool. Sized for the container, not for the cluster: a small instance
# cannot drive many concurrent cursors, and each idle socket is a live TLS session
# held in memory. Raise both on a box with real cores behind it.
MONGO_MAX_POOL_SIZE=8
MONGO_MIN_POOL_SIZE=2

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# Password hashing work factor. Each step doubles the CPU a sign-up and every
# login costs, and this runs on pure-JS bcrypt — 10 is what a fractional-CPU
# instance can answer inside a browser's timeout. Existing hashes carry their own
# cost and keep verifying, so this only ever applies to newly set passwords: put
# it back to 12 the moment this is deployed somewhere with a dedicated core.
BCRYPT_ROUNDS=10

# ---------- Account lockout ----------
# Consecutive wrong passwords before an account is closed to sign-in, and for how
# long. This caps guesses per account no matter how many IPs they arrive from —
# the per-IP limiter alone cannot. The window is fixed from the moment it trips:
# attempts made during a lock do not extend it, so waiting it out works. The owner
# is emailed when it trips, and completing a password reset lifts it immediately.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# ---------- Login sessions (the "Manage devices" screen) ----------
# Idle cut-off: a device that has not made a request in this long is signed out even
# though its refresh token has not run out. The absolute ceiling is always
# JWT_REFRESH_EXPIRES above — a session never outlives the token that renews it.
SESSION_INACTIVITY_DAYS=30
# How stale "last active" may get before an authenticated request writes it back.
SESSION_TOUCH_INTERVAL_SECONDS=60
# Concurrent devices per account. A new login is never refused; the least recently
# used session is signed out instead.
SESSION_MAX_PER_USER=20

# ---------- Approximate login location ----------
# Shown on the devices screen so the account holder can recognise their own logins.
# Entirely optional — with GEOIP_ENABLED=false the screen simply shows no place.
# A CDN header (Cloudflare, Vercel, CloudFront) is preferred when present and this
# lookup is skipped. {ip} is substituted into the URL.
GEOIP_ENABLED=true
GEOIP_URL=http://ip-api.com/json/{ip}?fields=status,country,countryCode,regionName,city
GEOIP_TIMEOUT_MS=2000

# ---------- Google sign-in ----------
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Must be the SAME value as the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- CORS (comma separated) ----------
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Public origin of this API ----------
# Email artwork is served from here, so it must be an address a recipient's
# inbox can reach. Leave unset in development (defaults to http://localhost:PORT,
# which only renders on your own machine); set it in production.
SERVER_URL=

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=premium-ecommerce

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Mail (password reset) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Premium Store <no-reply@example.com>"
# Hold one authenticated connection open and reuse it, instead of paying for a
# TCP connect, a TLS handshake and an AUTH exchange per message.
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=2
# Ceilings per stage of a send, so a provider that accepts the connection and
# then goes quiet cannot hold a socket — or a request — indefinitely.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# How long a request that triggered a mail waits for it before answering anyway.
# The send is not cancelled and the message still arrives; this only decides how
# long a shopper watches a spinner for it. Keep it well under the client's own
# 30s request timeout.
MAIL_REQUEST_DEADLINE_MS=4000

# ---------- Commerce rules ----------
FREE_SHIPPING_THRESHOLD=499
SHIPPING_FLAT_RATE=49
