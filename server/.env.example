# Copy to .env and fill in the blanks. Never commit the real .env.

# ---------- Core ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/premium-ecommerce

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12

# ---------- Account lockout ----------
# Consecutive wrong passwords before an account is closed to sign-in, and for how
# long. This caps guesses per account no matter how many IPs they arrive from —
# the per-IP limiter alone cannot. The window is fixed from the moment it trips:
# attempts made during a lock do not extend it, so waiting it out works. The owner
# is emailed when it trips, and completing a password reset lifts it immediately.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# ---------- Login sessions (the "Manage devices" screen) ----------
# Idle cut-off: a device that has not made a request in this long is signed out even
# though its refresh token has not run out. The absolute ceiling is always
# JWT_REFRESH_EXPIRES above — a session never outlives the token that renews it.
SESSION_INACTIVITY_DAYS=30
# How stale "last active" may get before an authenticated request writes it back.
SESSION_TOUCH_INTERVAL_SECONDS=60
# Concurrent devices per account. A new login is never refused; the least recently
# used session is signed out instead.
SESSION_MAX_PER_USER=20

# ---------- Approximate login location ----------
# Shown on the devices screen so the account holder can recognise their own logins.
# Entirely optional — with GEOIP_ENABLED=false the screen simply shows no place.
# A CDN header (Cloudflare, Vercel, CloudFront) is preferred when present and this
# lookup is skipped. {ip} is substituted into the URL.
GEOIP_ENABLED=true
GEOIP_URL=http://ip-api.com/json/{ip}?fields=status,country,countryCode,regionName,city
GEOIP_TIMEOUT_MS=2000

# ---------- Google sign-in ----------
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Must be the SAME value as the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- CORS (comma separated) ----------
# CLIENT_URL doubles as the storefront's public origin: it is the base of every
# canonical URL, hreflang alternate and sitemap entry, so in production it must be
# the address customers actually visit.
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Serve the storefront from this process (optional) ----------
# Point this at the client's build output and the API also serves the SPA, with
# each page's meta tags rewritten for the URL requested. That is what makes a
# shared product link preview as that product in WhatsApp/Facebook/LinkedIn —
# their crawlers never run JavaScript, so tags the app sets at runtime are invisible
# to them. Leave blank to keep this an API-only process (the default).
#   e.g. CLIENT_DIST_PATH=../client/dist
CLIENT_DIST_PATH=

# ---------- Public origin of this API ----------
# Email artwork is served from here, so it must be an address a recipient's
# inbox can reach. Leave unset in development (defaults to http://localhost:PORT,
# which only renders on your own machine); set it in production.
SERVER_URL=

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=premium-ecommerce

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Mail (verification codes, password reset) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Premium Store <no-reply@example.com>"

# How long a message may spend at each stage before the send is abandoned. These
# exist because nodemailer's own defaults (2min to connect, 10min on an idle
# socket) outlast the browser: with a relay that is unreachable — many ISPs and
# office networks silently drop outbound port 587 — a sign-up would sit there
# until the storefront gave up at 30s and showed "the request timed out", with
# nothing logged anywhere. Keep every one of them well under REQUEST_TIMEOUT_MS.
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=12000
MAIL_SEND_TIMEOUT_MS=12000

# Ceiling on any single API request. Past this the client is answered with a 503
# rather than left waiting, and the stalled route is named in the server log.
# Must stay below the storefront's own 30s axios timeout to be of any use.
REQUEST_TIMEOUT_MS=25000

# ---------- Commerce rules ----------
FREE_SHIPPING_THRESHOLD=499
SHIPPING_FLAT_RATE=49
