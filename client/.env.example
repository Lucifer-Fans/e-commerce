# Copy to .env and fill in the blanks. Never commit the real .env.
# Vite inlines VITE_* vars into the client bundle — put no secrets here.

# VITE_API_URL is also read at BUILD time (not just in the browser): the build bakes
# the admin's Organization → SEO settings into index.html from it, so link-preview
# crawlers see the store's own meta rather than a placeholder. An unreachable API is
# a warning, not a failed build — the placeholder survives and the next build fixes it.
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME=Premium Store
VITE_SITE_URL=http://localhost:5173

# How long the build waits on that settings fetch before giving up.
VITE_SEO_BUILD_TIMEOUT_MS=8000

# Google OAuth 2.0 Web client ID — leave blank to hide the "Sign in with Google" button.
# Must match the server's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
